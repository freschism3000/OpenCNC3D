{
  "special": [
    {
      "id": "SCB20EA",
      "name": "Bad Neighborhood",
      "faction": "Nod",
      "theater": "Desert",
      "width": 60,
      "height": 60,
      "starts": 20,
      "briefing": "We need to remove all GDI forces from this area. Unfortunately, the civilians in this area are GDI friendly. You must remain undetected until your base is ready. If either GDI or the civilians discover you, GDI will attack.",
      "group": "Nod Covert"
    },
    {
      "id": "SCB21EA",
      "name": "Eviction Notice",
      "faction": "Nod",
      "theater": "Desert",
      "width": 58,
      "height": 53,
      "starts": 21,
      "briefing": "GDI influence in this area is running rampant. Establish a well positioned strike base, and clean the area out. A nearby town may provide a suitable location for your base, if the occupants were \"persuaded\" to move....",
      "group": "Nod Covert"
    },
    {
      "id": "SCB22EB",
      "name": "N64 Special Ops 2",
      "faction": "Nod",
      "theater": "Desert",
      "width": 62,
      "height": 62,
      "starts": 20,
      "briefing": "",
      "group": "Nod Special Ops"
    },
    {
      "id": "SCB31EA",
      "name": "The Tiberium Strain",
      "faction": "Nod",
      "theater": "Temperate",
      "width": 60,
      "height": 60,
      "starts": 4,
      "briefing": "A nearby GDI base is conducting further ion research. In doing so, they use a large number of chemicals, located in their bio centers. Destroy all the bio centers, and \"contaminate\" all units and civilians. Leave all the other structures intact, so that it looks like an accident.",
      "group": "Nod Covert"
    },
    {
      "id": "SCB32EA",
      "name": "Cloak and Dagger",
      "faction": "Nod",
      "theater": "Temperate",
      "width": 60,
      "height": 60,
      "starts": 10,
      "briefing": "GDI has intercepted and captured one of our MCVs. We were counting on that vehicle to establish a foothold in the area. Recover the MCV and remove any trace that GDI had even been there.",
      "group": "Nod Covert"
    },
    {
      "id": "SCB33EA",
      "name": "Hostile Takeover",
      "faction": "Nod",
      "theater": "Desert",
      "width": 60,
      "height": 61,
      "starts": 21,
      "briefing": "This mission is simple. GDI has taken a region that belongs to us. Take it back.",
      "group": "Nod Covert"
    },
    {
      "id": "SCB35EA",
      "name": "Under Siege: C&C",
      "faction": "Nod",
      "theater": "Temperate",
      "width": 50,
      "height": 53,
      "starts": 9,
      "briefing": "GDI has pinned us down inside our base, and funds have run out. Reports have it that GDI is ready to send in Airstrikes to finish us off. The situation looks hopeless...",
      "group": "Nod Covert"
    },
    {
      "id": "SCB37EA",
      "name": "Nod Death Squad",
      "faction": "Nod",
      "theater": "Desert",
      "width": 48,
      "height": 49,
      "starts": 15,
      "briefing": "After our setback in Europe, our recovery efforts have been hindered by GDI's use of its Ion Cannon. Now they have a relay in North Africa! We only have limited forces, but you must take out the Advanced Comm. Center or slowly Africa will begin to fall as well.",
      "group": "Nod Covert"
    },
    {
      "id": "SCB60EA",
