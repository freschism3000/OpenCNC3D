    {
      "id": "SCG22EA",
      "name": "Blackout",
      "faction": "GDI",
      "theater": "Temperate",
      "width": 59,
      "height": 60,
      "starts": 17,
      "briefing": "We need to establish a base in this area. Unfortunately, so does Nod. They have already put up Obelisks to guard the only way in. We need you to cut the power to the Obelisks before our MCV arrives. With the MCV, set up a base and eliminate the Nod forces.",
      "group": "GDI Covert"
    },
    {
      "id": "SCG23EA",
      "name": "Hell's Fury",
      "faction": "GDI",
      "theater": "Temperate",
      "width": 59,
      "height": 61,
      "starts": 13,
      "briefing": "Nod is attempting to rebuild their Temple with its Nuclear missile. Establish a base and wait for contact with Agent Delphi. He will show you the best way to their base. Use everything at your disposal to stop The Brotherhood.",
      "group": "GDI Covert"
    },
    {
      "id": "SCG30EA",
      "name": "N64 Special Ops 1",
      "faction": "GDI",
      "theater": "Temperate",
      "width": 48,
      "height": 53,
      "starts": 20,
      "briefing": "Nod is experimenting on civilians with Tiberium. Use the commando to take out the SAM sites surrounding the dropoff area. With the SAM's gone you will then get an airstrike.  Take out the Obelisk and an MCV will be delivered to help you to locate and destroy the biochem facility.",
      "group": "GDI Special Ops"
    },
    {
      "id": "SCG32EA",
      "name": "Test Map: Dynamic",
      "faction": "GDI",
      "theater": "Temperate",
      "width": 62,
      "height": 61,
      "starts": 22,
      "briefing": "",
      "group": "Test Maps"
    },
    {
      "id": "SCG36EA",
      "name": "Infiltrated!",
      "faction": "GDI",
      "theater": "Desert",
      "width": 57,
      "height": 57,
      "starts": 10,
      "briefing": "Infiltration! Nod has breached our base in Eastern Sudan and has begun taking it over! Recapture the base and reestablish our military dominance in the area.",
      "group": "GDI Covert"
    },
    {
      "id": "SCG38EA",
      "name": "Elemental Imperative",
      "faction": "GDI",
      "theater": "Temperate",
      "width": 45,
      "height": 44,
      "starts": 16,
      "briefing": "Nod has stolen some key components to our Tiberium research. Retrieve them. A local civilian is willing to help clear the way and take us to the site, if we free his wife and return her to safety.",
      "group": "GDI Covert"
    },
    {
      "id": "SCG40EA",
      "name": "Ground Zero",
      "faction": "GDI",
      "theater": "Temperate",
      "width": 60,
      "height": 60,
      "starts": 5,
      "briefing": "NOD has launched a missile which is aimed at the global peace conference. Get the delegates from the conference to the evac point as quickly as possible. Time is critical -- good luck.",
      "group": "GDI Covert"
    },
    {
      "id": "SCG41EA",
      "name": "Twist of Fate",
      "faction": "GDI",
      "theater": "Desert",
      "width": 60,
      "height": 60,
      "starts": 14,
      "briefing": "We had set up a small recon post in NOD territory, but they captured and reinforced it. Getting that post back would be a major coup. An MCV and armed convoy are on their way to aid you in establishing a new base. Once established, eliminate all NOD forces in the area.",
      "group": "GDI Covert"
    },
    {
      "id": "SCG50EA",
      "name": "Blindsided",
      "faction": "GDI",
      "theater": "Desert",
      "width": 57,
      "height": 58,
      "starts": 22,
      "briefing": "Your mission: Use your commando to establish control on our side of the river. We will send some help when all SAM sites are taken out. Then send your forces across the river and attack Nod from the rear. Destroy them all. They won't be surprised for long, so act quickly.",
      "group": "GDI Covert"
    },
