+    "        vec3 land=shoreGround.rgb*vCol.a;\n"
+    "        float ripple = clamp(luma(tile)/max(uProductMean,0.02),0.65,1.25);\n"
+    "        vec3 clearWater = mix(vec3(0.19,0.28,0.29),vec3(luma(tile))*vec3(0.72,0.90,0.94),0.25);\n"
+    "        vec3 wetSand = land * mix(0.82,0.72,memory);\n"
+    "        wash = mix(wetSand,clearWater,0.34+0.18*film) * mix(0.96,1.04,ripple-0.65);\n"
