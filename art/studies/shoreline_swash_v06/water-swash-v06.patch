+       The native depth test naturally stops this flat swash at raised banks. */
+    "    if(uFoam>0.5) {\n"
+    "        float phase = fract(uTime / 6.0 + clk.x / 6.2831853 * 0.32);\n"
+    "        float surge = phase < 0.28 ? smoothstep(0.0,0.28,phase) : 1.0-smoothstep(0.28,1.0,phase);\n"
+    "        vec2 stable = vWorld.xz * 0.62;\n"
+    "        float grain = texture2D(uFoamTex,stable).r;\n"
+    "        float fine = texture2D(uFoamTex,stable*2.3+vec2(0.17,0.39)).g;\n"
+    "        float span = max(uFoamCross,0.12) * mix(2.30,0.85,river);\n"
+    "        float front = mix(0.10,-span,surge) + (grain-0.5)*0.09;\n"
+    "        float film = smoothstep(front-0.035,front+0.065,sd);\n"
+    "        float coastBand = (1.0-smoothstep(0.10,0.30,sd)) * smoothstep(-span-0.09,-span+0.015,sd);\n"
+    "        float retreat = smoothstep(0.28,0.72,phase)*(1.0-smoothstep(0.78,1.0,phase));\n"
+    "        float memory = smoothstep(-span-0.04,-span+0.05,sd) * retreat;\n"
+    "        vec3 tile = texture2D(uW1,base-uPanV).rgb * texture2D(uW2,base-uPanV*0.6).rgb;\n"
