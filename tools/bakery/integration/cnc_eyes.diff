+   the 15 fps cadence. Note the honesty limit: the object dump does not carry the
+   Aircraft heap yet, so no live object reaches this path today; it is exercised by
+   --posetest with --turtest and will light up when aircraft are exported. */
+static float rotor_spin(void)
+{
+    return (float)(g_engineFrame & 1023) * 0.9f;
+}
