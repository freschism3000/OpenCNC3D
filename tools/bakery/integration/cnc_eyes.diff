+/* The extra yaw draw_mesh applies to a TURRET part for this object, DirType units.
+   Units: the turret tracks tface while the hull keeps face, so the offset is their
+   difference. Buildings are drawn unrotated (face -1 to draw_mesh), so the turret's
+   rest pose points the mesh's authored forward; the offset from THERE to the engine
+   facing aims it. GUN and SAM are the only building types whose face the engine
+   turns (bdata.cpp "rotating turret"), and SAM's launcher is baked static
+   (retracted rest pose), so in practice this rotates GUN's barrel assembly. */
+static int turret_delta(const SimObject& o)
+{
+    const int mi = mesh_for(o);
+    if (mi < 0 || !mesh_has_role(mi, ROLE_TURRET))
+        return 0;
+    if (o.kind == K_UNIT) {
+        if (o.face < 0 || o.tface < 0 || g_legacy)
+            return 0;
+        return (o.tface - o.face) & 255;
+    }
+    if (o.kind == K_BUILDING && o.face >= 0 && !g_legacy)
+        return (o.face - model_forward(o.type)) & 255;
+    return 0;
 }
 
