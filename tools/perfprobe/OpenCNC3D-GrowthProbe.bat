@echo off
setlocal EnableExtensions DisableDelayedExpansion
cd /d "%~dp0"
if not exist cnc_eyes.exe (echo Place this probe beside cnc_eyes.exe. & exit /b 2)
if not exist opencnc3d-fx.cfg (echo Missing opencnc3d-fx.cfg. & exit /b 2)
if not exist SCM01EA.pack (echo Missing SCM01EA.pack. & exit /b 2)
if not exist "performance-growth-results" mkdir "performance-growth-results"
set OPENCNC3D_BACKGROUND=1
set OPENCNC3D_FRAMEPROF=1
set OPENCNC3D_GPUPROF=1
set OPENCNC3D_PERFDETAIL=1
set "LOG=performance-growth-results\growth-performance.txt"
> "%LOG%" echo OpenCNC3D growth probe: tick-advancing render throughput; separate live soak
>> "%LOG%" echo Diagnostic immunity protects the player; normal build times and graphics settings remain active.
powershell -NoProfile -Command "Get-FileHash cnc_eyes.exe,opencnc3d-fx.cfg -Algorithm SHA256 | Format-List" >> "%LOG%" 2>&1
type nul > "performance-growth-results\script.txt"
>> "performance-growth-results\script.txt" echo gfxsave performance-growth-results/quality.cfg
>> "performance-growth-results\script.txt" echo gfx show_stats 0
>> "performance-growth-results\script.txt" echo cheatset invuln 1
>> "performance-growth-results\script.txt" echo tick 5
>> "performance-growth-results\script.txt" echo look MCV:@me
>> "performance-growth-results\script.txt" echo dist 3000
>> "performance-growth-results\script.txt" echo count MCV:@me 1
>> "performance-growth-results\script.txt" echo echo STEP^|MCV
