@echo off
rem OpenCNC3D performance probe v2. Drop this file into your OpenCNC3D folder
rem (the one with OpenCNC3D.exe in it) and double-click it. It takes about five
rem minutes, opens the game window a few times, and writes OpenCNC3D-perfprobe.txt.
rem Generated by tools/perfprobe/make-perfprobe.py; edit that, not this.
setlocal
title OpenCNC3D performance probe
cd /d "%~dp0"
if exist "cnc_eyes.exe" goto found
echo.
echo This file has to sit in your OpenCNC3D folder, next to OpenCNC3D.exe and
echo cnc_eyes.exe. Move it there and double-click it again.
echo.
pause
exit /b 1
:found
set "LOG=OpenCNC3D-perfprobe.txt"
set "GFX=--gfx"
if exist "opencnc3d-fx.cfg" set "GFX=--gfx opencnc3d-fx.cfg"
echo.
echo  OpenCNC3D performance probe
echo  ---------------------------
echo  The game will open and close by itself a few times, switching its graphics
echo  around. Please do not click in it or use the PC until this window says Done.
echo  It takes about five minutes.
echo.
type nul > "perfprobe-bigmap.txt"
>> "perfprobe-bigmap.txt" echo echo PROBE^|bigmap^|v1
>> "perfprobe-bigmap.txt" echo gfxsave perfprobe-fx.cfg
>> "perfprobe-bigmap.txt" echo tick 60
>> "perfprobe-bigmap.txt" echo echo SECTION^|baseline
>> "perfprobe-bigmap.txt" echo framebench 90
>> "perfprobe-bigmap.txt" echo echo CAM^|shroud_lifted
>> "perfprobe-bigmap.txt" echo reveal 1
>> "perfprobe-bigmap.txt" echo framebench 90
>> "perfprobe-bigmap.txt" echo echo CAM^|zoomed_out
>> "perfprobe-bigmap.txt" echo dist 4200
>> "perfprobe-bigmap.txt" echo framebench 90
>> "perfprobe-bigmap.txt" echo dist 3000
>> "perfprobe-bigmap.txt" echo echo OFF^|enhanced_terrain_art texset 3 to 1
>> "perfprobe-bigmap.txt" echo gfx texset 1
>> "perfprobe-bigmap.txt" echo framebench 60
>> "perfprobe-bigmap.txt" echo gfxload perfprobe-fx.cfg
>> "perfprobe-bigmap.txt" echo gfx texset 3
>> "perfprobe-bigmap.txt" echo echo MODE^|classic
>> "perfprobe-bigmap.txt" echo gfxmode 0
>> "perfprobe-bigmap.txt" echo framebench 60
>> "perfprobe-bigmap.txt" echo gfxmode 2
>> "perfprobe-bigmap.txt" echo gfxload perfprobe-fx.cfg
>> "perfprobe-bigmap.txt" echo gfx texset 3
>> "perfprobe-bigmap.txt" echo echo SECTION^|battle: a base is blown up
>> "perfprobe-bigmap.txt" echo blowup 1
>> "perfprobe-bigmap.txt" echo tick 1
>> "perfprobe-bigmap.txt" echo echo BATTLE^|after_1_more_ticks
>> "perfprobe-bigmap.txt" echo framebench 30
>> "perfprobe-bigmap.txt" echo tick 10
>> "perfprobe-bigmap.txt" echo echo BATTLE^|after_10_more_ticks
>> "perfprobe-bigmap.txt" echo framebench 30
>> "perfprobe-bigmap.txt" echo tick 30
>> "perfprobe-bigmap.txt" echo echo BATTLE^|after_30_more_ticks
>> "perfprobe-bigmap.txt" echo framebench 30
>> "perfprobe-bigmap.txt" echo tick 30
>> "perfprobe-bigmap.txt" echo echo BATTLE^|after_30_more_ticks
>> "perfprobe-bigmap.txt" echo framebench 30
>> "perfprobe-bigmap.txt" echo tick 60
>> "perfprobe-bigmap.txt" echo echo BATTLE^|after_60_more_ticks
>> "perfprobe-bigmap.txt" echo framebench 30
>> "perfprobe-bigmap.txt" echo meshperfdump
>> "perfprobe-bigmap.txt" echo echo PROBE^|bigmap^|done
>> "perfprobe-bigmap.txt" echo quit
type nul > "perfprobe-main.txt"
>> "perfprobe-main.txt" echo echo PROBE^|main^|v2
>> "perfprobe-main.txt" echo gfxsave perfprobe-fx.cfg
>> "perfprobe-main.txt" echo tick 60
>> "perfprobe-main.txt" echo echo SECTION^|baseline
>> "perfprobe-main.txt" echo framebench 60
>> "perfprobe-main.txt" echo framebench 300
>> "perfprobe-main.txt" echo echo OFF^|water_reflect_scene
>> "perfprobe-main.txt" echo gfx water_reflect_scene 0
>> "perfprobe-main.txt" echo framebench 150
>> "perfprobe-main.txt" echo gfxload perfprobe-fx.cfg
>> "perfprobe-main.txt" echo echo OFF^|enhanced_terrain_art texset 3 to 1
>> "perfprobe-main.txt" echo gfx texset 1
>> "perfprobe-main.txt" echo framebench 150
>> "perfprobe-main.txt" echo gfxload perfprobe-fx.cfg
>> "perfprobe-main.txt" echo gfx texset 3
>> "perfprobe-main.txt" echo echo MODE^|n64
>> "perfprobe-main.txt" echo gfxmode 1
>> "perfprobe-main.txt" echo framebench 150
>> "perfprobe-main.txt" echo gfxmode 2
>> "perfprobe-main.txt" echo gfxload perfprobe-fx.cfg
>> "perfprobe-main.txt" echo gfx texset 3
>> "perfprobe-main.txt" echo echo MODE^|enhanced_again
>> "perfprobe-main.txt" echo framebench 150
>> "perfprobe-main.txt" echo echo CAM^|shroud_lifted
>> "perfprobe-main.txt" echo reveal 1
>> "perfprobe-main.txt" echo framebench 200
>> "perfprobe-main.txt" echo echo PROBE^|main^|done
>> "perfprobe-main.txt" echo quit
> "%LOG%" echo ===== OPENCNC3D PERF PROBE v2 =====
>> "%LOG%" echo date: %DATE% %TIME%
if exist "BUILD-ID.txt" type "BUILD-ID.txt" >> "%LOG%"
>> "%LOG%" echo ===== SYSTEM =====
powershell -NoProfile -Command "Get-CimInstance Win32_VideoController | Format-List Name,DriverVersion,VideoModeDescription,CurrentRefreshRate; Get-CimInstance Win32_Processor | Format-List Name,NumberOfCores,NumberOfLogicalProcessors,MaxClockSpeed; Get-CimInstance Win32_OperatingSystem | Format-List Caption,Version,OSArchitecture; 'RAM GB: {0:N1}' -f ((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory/1GB)" >> "%LOG%" 2>&1
powercfg /getactivescheme >> "%LOG%" 2>&1
>> "%LOG%" echo ===== SETTINGS: opencnc3d-fx.cfg =====
if exist "opencnc3d-fx.cfg" type "opencnc3d-fx.cfg" >> "%LOG%"
if not exist "opencnc3d-fx.cfg" >> "%LOG%" echo no saved settings: the shipped defaults
set "OPENCNC3D_FRAMEPROF=1"
echo  Run 1 of 4: GDI mission 1, the shipped renderer ...
>> "%LOG%" echo ===== RUN 1 of 4: GDI mission 1, the shipped renderer [cnc_eyes.exe] =====
>> "%LOG%" echo start %TIME%
cnc_eyes.exe --scen SCG01EA --pack SCG01EA.pack --dylib TiberianDawn.dll --dir missions/ --content content/ --nosound --w 1920 --h 1080 --enhanced --texset 3 %GFX% --showwindow --script perfprobe-main.txt >> "%LOG%" 2>&1
>> "%LOG%" echo exit code %ERRORLEVEL%, end %TIME%
if not exist "cnc_eyes_sse2.exe" goto skip2
echo  Run 2 of 4: GDI mission 1, the SSE2 renderer ...
>> "%LOG%" echo ===== RUN 2 of 4: GDI mission 1, the SSE2 renderer [cnc_eyes_sse2.exe] =====
>> "%LOG%" echo start %TIME%
cnc_eyes_sse2.exe --scen SCG01EA --pack SCG01EA.pack --dylib TiberianDawn.dll --dir missions/ --content content/ --nosound --w 1920 --h 1080 --enhanced --texset 3 %GFX% --showwindow --script perfprobe-main.txt >> "%LOG%" 2>&1
>> "%LOG%" echo exit code %ERRORLEVEL%, end %TIME%
:skip2
echo  Run 3 of 4: a large map and a battle, the shipped renderer ...
>> "%LOG%" echo ===== RUN 3 of 4: a large map and a battle, the shipped renderer [cnc_eyes.exe] =====
>> "%LOG%" echo start %TIME%
cnc_eyes.exe --scen SCG10EA --pack SCG10EA.pack --dylib TiberianDawn.dll --dir missions/ --content content/ --nosound --w 1920 --h 1080 --enhanced --texset 3 %GFX% --showwindow --script perfprobe-bigmap.txt >> "%LOG%" 2>&1
>> "%LOG%" echo exit code %ERRORLEVEL%, end %TIME%
if not exist "cnc_eyes_sse2.exe" goto skip4
echo  Run 4 of 4: a large map and a battle, the SSE2 renderer ...
>> "%LOG%" echo ===== RUN 4 of 4: a large map and a battle, the SSE2 renderer [cnc_eyes_sse2.exe] =====
>> "%LOG%" echo start %TIME%
cnc_eyes_sse2.exe --scen SCG10EA --pack SCG10EA.pack --dylib TiberianDawn.dll --dir missions/ --content content/ --nosound --w 1920 --h 1080 --enhanced --texset 3 %GFX% --showwindow --script perfprobe-bigmap.txt >> "%LOG%" 2>&1
>> "%LOG%" echo exit code %ERRORLEVEL%, end %TIME%
:skip4
>> "%LOG%" echo ===== THE LAST GAME LOG: opencnc3d-log.txt, last 800 lines =====
powershell -NoProfile -Command "if (Test-Path 'opencnc3d-log.txt') { Get-Content 'opencnc3d-log.txt' -Tail 800 }" >> "%LOG%" 2>&1
>> "%LOG%" echo ===== END =====
del "perfprobe-bigmap.txt" >nul 2>&1
del "perfprobe-main.txt" >nul 2>&1
del "perfprobe-fx.cfg" >nul 2>&1
echo.
echo  Done. Please send this file back:
echo.
echo     %CD%\%LOG%
echo.
explorer /select,"%CD%\%LOG%"
pause
