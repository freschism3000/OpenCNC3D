+/***********************************************************************************************
+ * OpenCNC3D_Text_Or -- Text_String() that can never hand a NULL format to printf.                 *
+ *                                                                                             *
+ *    Text_String() resolves against SystemStrings, and SystemStrings is filled only by the    *
+ *    engine's own start-up path. A host that drives the engine through the exported C entry   *
+ *    points never runs that path, so every Text_String() call returns NULL in that            *
+ *    configuration. Almost everywhere that is harmless, because the pointer is handed to      *
+ *    routines that tolerate NULL. It is not harmless below, where one is passed to sprintf    *
+ *    as the FORMAT argument: a NULL format dereferences address zero and takes the process    *
+ *    down at the exact moment a human house is defeated, which is the only route to the       *
+ *    multiplayer end-of-game result.                                                          *
+ *                                                                                             *
+ *    The text is cosmetic. The Add_Message call these strings were built for is commented     *
+ *    out, so a plain fallback costs nothing and keeps the defeat bookkeeping after it         *
+ *    running, which is the part that matters.                                                 *
+ *                                                                                             *
+ * INPUT:   string   -- the text number to resolve.                                            *
+ *                                                                                             *
+ *          fallback -- what to use when the string table is absent. It must carry the same    *
+ *                      conversion specifiers as the real string.                              *
+ *                                                                                             *
+ * OUTPUT:  Returns a pointer that is never NULL.                                              *
+ *                                                                                             *
+ * WARNINGS:   none                                                                            *
+ *=============================================================================================*/
+static char const* OpenCNC3D_Text_Or(int string, char const* fallback)
+{
+    char const* text = Text_String(string);
+    return (text != NULL) ? text : fallback;
+}
