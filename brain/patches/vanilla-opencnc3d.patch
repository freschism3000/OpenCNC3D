+/**************************************************************************************************
+ * OpenCNC3D_Event_ABI -- fingerprint the order wire, so a mismatched peer is refused at the door
+ *                    rather than corrupting a match (project OpenCNC3D).
+ *
+ * WHY A FINGERPRINT AND NOT A SIZE. EventClass IS the wire unit: lockstep copies it whole. Its
+ * size is asserted at 22 bytes beside the class, and that assertion passes in BOTH brains while
+ * their wires are NOT interchangeable. The classic brain has `typedef unsigned COORDINATE` and
+ * `typedef signed short CELL`; the Enhanced brain widened them to uint64_t and int32_t. The union
+ * arms are textually identical and both are packed, so three wire-eligible event types put their
+ * fields in different places: ANIMATION's arm is 10 bytes against 14 and its Visible field moves
+ * from Data+6 to Data+10, and PLACE and SPECIAL differ too. The total stays 22 only because
+ * Data.Options is the widest arm in both and hides the difference.
+ *
+ * So "the sizes match" is exactly the reassurance that would let two incompatible peers agree to
+ * play and then silently disagree about the world. What a host must compare is the LAYOUT, and the
+ * cheapest complete statement of the layout is EventLength[], which is computed per type from the
+ * real structure rather than written down. Hashing the whole table catches any arm that moved.
+ *
+ * FLAT u32 SLOTS, not a struct, deliberately. The host mirrors this across a C ABI and across two
+ * architectures; a struct would add its own padding question to the very thing being checked.
+ * The count grows at the end only, so an older host reading fewer slots still reads them correctly.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Event_ABI(unsigned int* out, int count)
+{
+    unsigned int slot[OPENCNC3D_EVENT_ABI_SLOTS];
+    int i;
+
+    /*
+    **	A 32 bit FNV-1a over the whole per-type length table. Any union arm that changes width on
+    **	any type changes this, which is the property the size alone does not have.
+    */
+    unsigned int hash = 2166136261u;
+    for (i = 0; i < (int)EventClass::LAST_EVENT; i++) {
+        hash ^= (unsigned int)EventClass::EventLength[i];
+        hash *= 16777619u;
+    }
+
+    slot[0] = 1;                                        /* fingerprint format version */
+    slot[1] = (unsigned int)sizeof(EventClass);         /* asserted 22 */
+    slot[2] = (unsigned int)offsetof(EventClass, Data); /* where the payload starts */
+    slot[3] = 24;                                       /* EventClass::Frame bit width */
+    slot[4] = 7;                                        /* EventClass::ID bit width */
+    slot[5] = 1;                                        /* EventClass::IsExecuted bit width */
+    slot[6] = (unsigned int)sizeof(COORDINATE);         /* the two typedefs that split the brains */
+    slot[7] = (unsigned int)sizeof(CELL);
+    slot[8] = (unsigned int)sizeof(TARGET);
+    slot[9] = (unsigned int)EventClass::LAST_EVENT;     /* number of event types */
+    slot[10] = hash;                                    /* the deciding value */
+
+    for (i = 0; i < count && i < OPENCNC3D_EVENT_ABI_SLOTS; i++) {
+        out[i] = slot[i];
+    }
+    return (OPENCNC3D_EVENT_ABI_SLOTS);
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Drain_Events -- take this peer's pending orders out for the wire (project OpenCNC3D).
+ *
+ * Copies up to `max` events out of OutList and REMOVES them, stamping each one the way the classic
+ * network path did before the GlyphX conversion replaced it: a frame far enough ahead that every
+ * peer can have received it by then, and the originating house index.
+ *
+ * THE TRAP THIS EXPORT IS BUILT AROUND. Removing the local copy is correct ONLY because the host
+ * sends these bytes to every peer INCLUDING ITSELF and posts them back through OpenCNC3D_Post_Event. A
+ * host that drains and does not loop back loses every order the player gives, and it looks exactly
+ * like a network fault: the game runs, the other side moves, and your own clicks do nothing. That
+ * is a morning lost to tcpdump. So the drain REFUSES to run unless lockstep is on, and a host that
+ * has not called OpenCNC3D_Set_Lockstep gets -1 rather than an empty queue that reads as "no orders".
+ *
+ * Returns the number of events written, or -1 if lockstep is off, or -2 on a bad argument.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Drain_Events(void* out, int max, int frame_delay)
+{
+    if (!OpenCNC3D_Lockstep) {
+        return (-1);
+    }
+    if (out == NULL || max <= 0 || frame_delay < 0) {
+        return (-2);
+    }
+
+    unsigned char* dest = (unsigned char*)out;
+    int written = 0;
+
+    while (OutList.Count && written < max) {
+        OutList.First().Frame = (unsigned)Frame + (unsigned)frame_delay;
+        OutList.First().ID = Houses.ID(PlayerPtr);
+        OutList.First().IsExecuted = 0;
+        memcpy(dest + ((size_t)written * sizeof(EventClass)), &OutList.First(), sizeof(EventClass));
+        OutList.Next();
+        written++;
+    }
+
+    return (written);
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Post_Event -- inject a received order at its stamped frame (project OpenCNC3D).
+ *
+ * The other half of the drain. Every peer posts every peer's orders, its own included, so all
+ * machines put the identical set into DoList and execute it at the identical frame.
+ *
+ * It validates rather than trusting, because these bytes came off a wire: an event stamped for a
+ * frame already executed can never run and would desynchronise this peer silently, and a house
+ * index outside the roster would index Houses.Raw_Ptr out of range inside Execute.
+ *
+ * Returns 1 on success, 0 if DoList is full, -1 if lockstep is off, -2 on a bad argument,
+ * -3 if the frame has already passed, -4 if the house index is out of range.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Post_Event(const void* in)
+{
+    if (!OpenCNC3D_Lockstep) {
+        return (-1);
+    }
+    if (in == NULL) {
+        return (-2);
+    }
+
+    EventClass event;
+    memcpy(&event, in, sizeof(EventClass));
+
+    if ((unsigned)event.Frame < (unsigned)Frame) {
+        return (-3);
+    }
+    if ((int)event.ID >= (int)HOUSE_COUNT) {
+        return (-4);
+    }
+
+    event.IsExecuted = 0;
+    if (!DoList.Add(event)) {
+        return (0);
+    }
+    return (1);
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Set_Lockstep -- put this brain into deterministic lockstep mode (project OpenCNC3D).
+ *
+ * WHY THIS EXPORT EXISTS. A network match needs every machine to compute one identical world.
+ * The campaign needs the behaviour players remember. In a handful of places those two wants
+ * disagree, because the 1995 simulation reads state that belongs to one machine: the camera,
+ * the viewport, the local player, a wall clock, libc rand(), the local selection. All of that
+ * is harmless in a game of one, and fatal in a game where every peer must agree.
+ *
+ * So the fixes are GATED rather than applied, and this is the gate. It is false until a host
+ * calls this, which means the shipped campaign and today's skirmish take the 1995 path and
+ * cannot be moved by anything behind the flag. Nothing in the engine sets it; only the netcode
+ * will, once there is a match to set it for.
+ *
+ * It is deliberately one global rather than a per-instance member: lockstep is a property of
+ * the whole simulation, and a per-player flag would invite exactly the split-brain state this
+ * exists to prevent.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) void __cdecl OpenCNC3D_Set_Lockstep(bool on)
+{
+    OpenCNC3D_Lockstep = on;
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Get_Lockstep -- report the flag, so a host can assert what it asked for took.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Get_Lockstep(void)
+{
+    return OpenCNC3D_Lockstep;
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Set_Invincible -- Damage immunity for one player, for the cheat menu (project OpenCNC3D).
+ *
+ * WHY THIS EXPORT EXISTS. The exported debug interface covers everything a tester needs
+ * except this. CNC_Handle_Debug_Request has DEBUG_REQUEST_ADD_RESOURCES for money,
+ * DEBUG_REQUEST_END_PRODUCTION for instant build, DEBUG_REQUEST_UNLOCK_BUILDABLES for the
+ * tech tree and DEBUG_REQUEST_UNSHROUD for the shroud, but nothing for damage. The nearest
+ * thing it has, DEBUG_REQUEST_KILL_OBJECT with the object name "HEAL", runs
+ * DLLExportClass::Debug_Heal_Unit(x, y), which resolves a SCREEN PIXEL through
+ * Map.Pixel_To_Coord and tops up the one object it lands on. That cannot reach anything
+ * outside the tactical window, it is a one-shot rather than a state, and it loses the race
+ * against sustained fire. A switch has to live where damage is applied, so this export sets
+ * a house bit that ObjectClass::Take_Damage reads (object.cpp; it holds the game's only
+ * statement that subtracts damage from Strength, and every Take_Damage override in the
+ * hierarchy calls down into it).
+ *
+ * WHAT IT DOES NOT DO. It does not make the house invisible to the enemy or stop the enemy
+ * attacking: the AI keeps targeting, keeps firing, and its shells keep landing. They just
+ * do not reduce Strength. That is the point for testing, because an AI that stops shooting
+ * would hide exactly the behaviour a tester wants to watch.
+ *
+ * SCOPE. Default OFF, and ObjectClass::Init clears the mask, which Clear_Scenario calls, so
+ * it cannot follow the player into the next scenario or into a loaded save.
+ *
+ * Returns false when player_id names nobody in this match, in which case nothing changed.
+ **************************************************************************************************/
+
+/*
+**	Which house does a GlyphX player id own?
+**
+**	This repeats the lookup inside DLLExportClass::Set_Player_Context rather than calling it,
+**	on purpose. Set_Player_Context does not only resolve an id, it MOVES the engine's local
+**	player: it reassigns PlayerPtr, MPlayerLocalID and the selection context, and it leaves
+**	them moved. That is right for CNC_Handle_Debug_Request, which then acts as that player,
+**	and wrong for a cheat toggle and its read-back, which must be able to ask about the
+**	computer's house without quietly making the computer the local player.
+**
+**	The two arms match Set_Player_Context's own: GAME_NORMAL has exactly one local house and
+**	does not consult the id at all, and every other mode walks GlyphxPlayerIDs. Returns
+**	HOUSE_NONE when the id is in neither.
+*/
+static HousesType OpenCNC3D_House_Of_Player(uint64 player_id)
+{
+    if (GameToPlay == GAME_NORMAL) {
+        return (PlayerPtr != NULL) ? PlayerPtr->Class->House : HOUSE_NONE;
+    }
+
+    for (int i = 0; i < MPlayerCount; i++) {
+        if (DLLExportClass::GlyphxPlayerIDs[i] == player_id) {
+            return MPlayerHouses[i];
+        }
+    }
+    return HOUSE_NONE;
+}
+
+/* AC4249: the Enhanced sidebar may show a grey cameo only when this mission's
+   actual rules can eventually unlock it. The display catalog's multiplayer level
+   cannot answer campaign Scenario gates or captured-factory restrictions.
+
+   Close the potential prerequisite tree through the SAME Can_Build predicate used
+   for production. A missing own factory is replaceable; its current presence or
+   busy radio contact must not erase grey future options. Other factions enter only
+   through an owned captured producer or construction yard. Existing prereqs count
+   even when their type cannot be newly built in this mission. No game state is
+   changed, and no technology level or faction restriction is bypassed. */
+static int OpenCNC3D_Production_Category(RTTIType type)
+{
+    switch (type) {
+    case RTTI_BUILDINGTYPE: return 0;
+    case RTTI_INFANTRYTYPE: return 1;
+    case RTTI_UNITTYPE: return 2;
+    case RTTI_AIRCRAFTTYPE: return 3;
+    default: return -1;
+    }
+}
+
+static unsigned int OpenCNC3D_Production_Faction(HousesType house)
+{
+    return house == HOUSE_GOOD ? 1u : house == HOUSE_BAD ? 2u : 0u;
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Get_Build_Potential(
+    uint64 player_id, OpenCNC3D_BuildPotentialEntry* entries, int capacity)
+{
+    const HousesType owner = OpenCNC3D_House_Of_Player(player_id);
+    const HouseClass* house = owner != HOUSE_NONE ? HouseClass::As_Pointer(owner) : NULL;
+    if (!house || capacity < 0 || (capacity && !entries)) return -1;
+
+    unsigned int producers[4] = { OpenCNC3D_Production_Faction(house->ActLike), 0, 0, 0 };
+    unsigned int prerequisites = house->ActiveBScan;
+    for (int i = 0; i < Buildings.Count(); ++i) {
+        const BuildingClass* b = Buildings.Ptr(i);
+        if (!b || b->House != house || b->IsInLimbo || b->Mission == MISSION_DECONSTRUCTION)
+            continue;
+        const int category = OpenCNC3D_Production_Category(b->Class->ToBuild);
+        if (category >= 0) producers[category] |= OpenCNC3D_Production_Faction(b->ActLike);
+    }
+
+    bool changed;
+    do {
+        changed = false;
+        /* All building prerequisite bits are in the first 32 type slots; civilian
+           scenery beyond that is not buildable and must not be shifted into a mask. */
+        for (int i = STRUCT_FIRST; i < STRUCT_COUNT && i < 32; ++i) {
+            const BuildingTypeClass& type = BuildingTypeClass::As_Reference((StructType)i);
+            for (int faction = 0; faction < 2; ++faction) {
+                const unsigned int bit = 1u << faction;
+                if (!(producers[0] & bit) || !house->Can_Build_With_Prerequisites(
+                        &type, faction ? HOUSE_BAD : HOUSE_GOOD, prerequisites)) continue;
+                const unsigned int old = prerequisites;
+                prerequisites |= 1u << i;
+                changed = changed || old != prerequisites;
+                const int category = OpenCNC3D_Production_Category(type.ToBuild);
+                if (category >= 0) {
+                    /* BuildingClass's constructor fixes side-specific factories to
+                       their original side, even when built from a captured yard. */
+                    HousesType acts = house->ActLike;
+                    if (i == STRUCT_HAND || i == STRUCT_AIRSTRIP) acts = HOUSE_BAD;
+                    if (i == STRUCT_BARRACKS || i == STRUCT_WEAP) acts = HOUSE_GOOD;
+                    const unsigned int before = producers[category];
+                    producers[category] |= OpenCNC3D_Production_Faction(acts);
+                    changed = changed || before != producers[category];
+                }
+            }
+        }
+        /* Some campaign unlocks are earned by capturing a scenario prerequisite,
+           notably Nod mission 11's MISSION building for STNK. Include those only
+           when an engineer is already owned or can be unlocked by this same tree. */
+        bool can_capture = false;
+        for (int i = 0; i < Infantry.Count(); ++i) {
+            const InfantryClass* inf = Infantry.Ptr(i);
+            if (inf && inf->House == house && !inf->IsInLimbo && inf->Class->Type == INFANTRY_E7)
+                can_capture = true;
+        }
+        const InfantryTypeClass& engineer = InfantryTypeClass::As_Reference(INFANTRY_E7);
+        for (int faction = 0; faction < 2; ++faction)
+            if ((producers[1] & (1u << faction)) && house->Can_Build_With_Prerequisites(
+                    &engineer, faction ? HOUSE_BAD : HOUSE_GOOD, prerequisites)) can_capture = true;
+        if (can_capture) for (int i = 0; i < Buildings.Count(); ++i) {
+            const BuildingClass* b = Buildings.Ptr(i);
+            if (!b || b->IsInLimbo || b->Mission == MISSION_DECONSTRUCTION || !b->Class->IsCaptureable)
+                continue;
+            const int type = (int)b->Class->Type;
+            if (type >= 0 && type < 32) {
+                const unsigned int before = prerequisites;
+                prerequisites |= 1u << type;
+                changed = changed || before != prerequisites;
+            }
+        }
+    } while (changed);
+
+    const RTTIType kinds[4] = { RTTI_BUILDINGTYPE, RTTI_INFANTRYTYPE, RTTI_UNITTYPE, RTTI_AIRCRAFTTYPE };
+    const int counts[4] = { STRUCT_COUNT, INFANTRY_COUNT, UNIT_COUNT, AIRCRAFT_COUNT };
+    int count = 0;
+    for (int kind = 0; kind < 4; ++kind) for (int id = 0; id < counts[kind]; ++id) {
+        const TechnoTypeClass* type = Fetch_Techno_Type(kinds[kind], id);
+        bool possible = false;
+        for (int faction = 0; type && faction < 2; ++faction)
+            if ((producers[kind] & (1u << faction)) && house->Can_Build_With_Prerequisites(
+                    type, faction ? HOUSE_BAD : HOUSE_GOOD, prerequisites)) possible = true;
+        if (!possible) continue;
+        if (count < capacity) {
+            memset(&entries[count], 0, sizeof entries[count]);
+            strncpy(entries[count].name, type->IniName, sizeof entries[count].name - 1);
+        }
+        ++count;
+    }
+    return count;
+}
+
+
+/**************************************************************************************************
+ * OpenCNC3D_Player_To_AI -- Hands one player's house to the computer (project OpenCNC3D).
+ *
+ * WHY THIS EXISTS. When somebody leaves a network match the room's AI TAKEOVER option says
+ * their base should carry on under the computer rather than blow up. The engine already
+ * knows how to do that: it is the #else arm of CNC_Handle_Player_Switch_To_AI, the path
+ * the Remastered build takes when KILL_PLAYER_ON_DISCONNECT is not defined. That arm is
+ * unreachable here, because the define is on and because it works on PlayerPtr through
+ * Set_Player_Context, which is per-machine state -- every peer has to apply this to the
+ * SAME house on the same frame, so the house is named rather than made current.
+ *
+ * WasHuman is what the score screen reads afterwards, so a taken-over player is still
+ * reported as the person who started the match rather than as a computer.
+ *
+ * The MCV loop is the original's: a house whose owner walked away mid-deploy would
+ * otherwise sit on a vehicle it will never unload, and the AI does not think to.
+ *
+ * Returns false when player_id names nobody, or when the house is already the computer's.
+ **************************************************************************************************/
+/**************************************************************************************************
+ * OpenCNC3D_Player_Is_AI -- Is this player's house being played by the computer? (project OpenCNC3D)
+ *
+ * The read that makes OpenCNC3D_Player_To_AI checkable. CNCPlayerInfoStruct carries an IsAI
+ * field, but Get_Player_Info_State never fills it -- it is an INPUT to
+ * CNC_Set_Multiplayer_Data and nothing more -- so there was no way to ask the engine
+ * afterwards whether a house is human or computer.
+ *
+ * Returns 1 for the computer, 0 for a person, -1 when player_id names nobody.
+ **************************************************************************************************/
+/**************************************************************************************************
+ * OpenCNC3D_Player_Blowup -- Destroys one player's house, the way a disconnect does (project OpenCNC3D).
+ *
+ * WHY NOT OpenCNC3D_Force_Verdict(player, false). Flag_To_Lose raises IsToLose, and
+ * HouseClass::AI only acts on IsToLose "if (GameToPlay == GAME_NORMAL)" (house.cpp).
+ * In a GlyphX multiplayer match -- which is every match this game plays -- that flag is
+ * therefore read by nobody: the departed player's base stood there untouched, being
+ * played by no one, and the log said the house had been flagged to lose. It had; the
+ * engine simply never looks.
+ *
+ * Flag_To_Die is the multiplayer-aware one, and it is what the engine's own
+ * KILL_PLAYER_ON_DISCONNECT arm calls. IsToDie has no GAME_NORMAL guard: a second later
+ * (BorrowedTime) HouseClass::AI runs Blowup_All and then MPlayer_Defeated, which is what
+ * puts "<name> has been defeated." on every player's screen. Units and buildings go up,
+ * on the same turn on every machine, because every machine calls this from the same turn.
+ *
+ * Returns whatever the flag returns: false when the house is already winning, losing or
+ * dying, so a second goodbye for one seat cannot restart the explosion.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Player_Blowup(uint64 player_id)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE) {
+        return false;
+    }
+
+    HouseClass* hptr = HouseClass::As_Pointer(house);
+    if (hptr == NULL) {
+        return false;
+    }
+
+    return hptr->Flag_To_Die();
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Player_Is_AI(uint64 player_id)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE) {
+        return -1;
+    }
+
+    HouseClass* hptr = HouseClass::As_Pointer(house);
+    if (hptr == NULL) {
+        return -1;
+    }
+
+    return hptr->IsHuman ? 0 : 1;
+}
+
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Player_To_AI(uint64 player_id)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE) {
+        return false;
+    }
+
+    HouseClass* hptr = HouseClass::As_Pointer(house);
+    if (hptr == NULL || !hptr->IsHuman) {
+        return false;
+    }
+
+    hptr->WasHuman = true;
+    hptr->IsHuman = false;
+    TD_Fair_AI_Assign(hptr, -1);
+    hptr->IsStarted = true;
+    hptr->IQ = Rule.MaxIQ;
+    hptr->IsBaseBuilding = true;
+
+    /*
+    ** Start the unload mission for MCVs, exactly as the disconnect path does.
+    */
+    for (int index = 0; index < Units.Count(); index++) {
+        UnitClass* obj = Units.Ptr(index);
+
+        if (obj && !obj->IsInLimbo && obj->House == hptr) {
+            if (*obj == UNIT_MCV) {
+                obj->Assign_Mission(MISSION_GUARD);
+                obj->Assign_Target(TARGET_NONE);
+                obj->Assign_Destination(TARGET_NONE);
+                obj->Assign_Mission(MISSION_UNLOAD);
+                obj->Commence();
+            }
+        }
+    }
+
+    return true;
+}
+
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Set_Invincible(uint64 player_id, bool on)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE) {
+        return false;
+    }
+
+    ObjectClass::OpenCNC3D_Set_Invincible(house, on);
+    return true;
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Get_Invincible -- Reports the invincibility bit for one player (project OpenCNC3D).
+ *
+ * The switch has no other reader, so a cheat menu that wants to redraw its own checkbox after
+ * a scenario change (which clears the mask) has to be able to ask. Pure query: it changes
+ * nothing, not even the engine's idea of who the local player is.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Get_Invincible(uint64 player_id)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE || house >= HOUSE_COUNT) {
+        return false;
+    }
+    return ((ObjectClass::OpenCNC3D_InvincibleHouses & (1 << house)) != 0);
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Set_Build_Anywhere -- Lifts the base adjacency rule for one player (project OpenCNC3D).
+ *
+ * WHY THIS EXPORT EXISTS. The debug interface has no switch for placement at all. Its nearest
+ * relative, DEBUG_REQUEST_UNLOCK_BUILDABLES, unlocks WHAT you may build and says nothing about
+ * WHERE, which is a different rule enforced in a different place -- DisplayClass's proximity
+ * check, the routine that decides whether a foundation is close enough to something you own.
+ *
+ * WHAT IT DOES NOT DO, and this is the whole of the request rather than a caveat: it does not
+ * make the ground buildable. Terrain legality lives in CellClass, is not consulted from the
+ * proximity check, and is untouched by this, so a player with the switch on can put a
+ * refinery on the far side of the map and still cannot put one in a river or up a cliff.
+ * That is the requirement in full: build anywhere, but not on ground that could never take
+ * a foundation.
+ *
+ * SCOPE. Default off, and DisplayClass::Init_Clear drops it. Clear_Scenario() calls that, and
+ * Clear_Scenario() is on every path that begins a scenario, so the switch cannot follow the
+ * player out of a skirmish and into a campaign mission.
+ *
+ * Returns false when player_id names nobody in this match, in which case nothing changed.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Set_Build_Anywhere(uint64 player_id, bool on)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE) {
+        return false;
+    }
+
+    DisplayClass::OpenCNC3D_Set_Build_Anywhere(house, on);
+    return true;
+}
+
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Get_Build_Anywhere(uint64 player_id)
+{
+    return DisplayClass::OpenCNC3D_Build_Anywhere(OpenCNC3D_House_Of_Player(player_id));
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Set_Free_Infantry -- Lets infantry walk straight lines at any angle (project OpenCNC3D).
+ *
+ * Sets OpenCNC3D_FreeInfantry (externs.h), read in InfantryClass::AI. It is one global rather than
+ * a per-house rule because it is a presentation of movement the renderer asks for, not a cheat
+ * one side has: every soldier on the map walks the same way. A lockstep match must set it the
+ * same on every peer before the first tick, or the worlds diverge; the renderer keeps it off
+ * in a match until the lobby carries it.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) void __cdecl OpenCNC3D_Set_Free_Infantry(bool on)
+{
+    OpenCNC3D_FreeInfantry = on;
+}
+
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Get_Free_Infantry(void)
+{
+    return OpenCNC3D_FreeInfantry;
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Set_Fast_Shells -- A vehicle's tank shell flies at twice its speed (project OpenCNC3D).
+ *
+ * Sets OpenCNC3D_FastShells (externs.h), read in TechnoClass::Fire_At. One global for the same
+ * reason as OpenCNC3D_Set_Free_Infantry, and under the same condition: a lockstep match must set
+ * it the same on every peer before the first tick, so the renderer keeps it off in a match.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) void __cdecl OpenCNC3D_Set_Fast_Shells(bool on)
+{
+    OpenCNC3D_FastShells = on;
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Set_Wall_Fill -- How far a placed wall reaches to join its own kind (project OpenCNC3D).
+ *
+ * Sets OpenCNC3D_WallFill (externs.h), read in BuildingClass::Unlimbo. 0 is the 1995 rule, one
+ * wall per piece placed; above 0 a piece a human places fills the straight gap to a wall of
+ * its own type and house at most that many cells away, the Tiberian Sun and Red Alert 2 rule.
+ * Clamped to 16, the engine's own ceiling on a GuardRange. One global, like
+ * OpenCNC3D_Set_Free_Infantry and for the same reason: a lockstep match must set it the same on
+ * every peer before the first tick, and the renderer keeps it at 0 in a match until the
+ * lobby carries it.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) void __cdecl OpenCNC3D_Set_Wall_Fill(int reach)
+{
+    OpenCNC3D_WallFill = (reach < 0) ? 0 : ((reach > 16) ? 16 : reach);
+}
+
+extern "C" __declspec(dllexport) int __cdecl OpenCNC3D_Get_Wall_Fill(void)
+{
+    return OpenCNC3D_WallFill;
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Proximity_Ok -- Would this building type pass the proximity check on this cell?
+ *
+ * A PURE QUERY. IT ANSWERS THE CURSOR ROUTINE, NOT THE COMMIT ROUTINE, and that distinction
+ * cost a round on 26 Aug 2026, so read it before trusting an answer from here.
+ *
+ * There are THREE copies of the adjacency rule in this engine and they are not the same rule:
+ *   DisplayClass::Passes_Proximity_Check  -- colours the cursor. Accepts adjacency to any
+ *                                            TECHNO, units included. This is what this query
+ *                                            calls.
+ *   DLLExportClass::Passes_Proximity_Check -- fills PlacementCellInfo, which is the overlay the
+ *                                            sidebar draws and the only thing the player sees.
+ *   BuildingClass::Passes_Proximity_Check  -- HouseClass::Place_Object's gate. Requires a
+ *                                            BUILDING next door, not merely a techno.
+ * And a fourth fact on top: DLLExportClass::Place has its proximity test commented out behind
+ * `#if (0)`, so a placement request from the client is honoured whatever any of them said.
+ *
+ * A green answer from this export therefore does NOT mean a building will go down there, and a
+ * red one does not mean it will not.
+ * Nothing else in the program can ask this question from outside a live placement: the flag the
+ * placement cursor reads is filled in per cell only while a structure is actually being placed,
+ * which needs a completed building and a minute of construction to reach. Gate G107 asks this
+ * instead, on the same cell, with the switch off and then on.
+ *
+ * It answers the same routine the real placement answers -- DisplayClass::Passes_Proximity_Check
+ * with the type's own occupy list -- so a green answer here and a red cursor in the game would
+ * be a genuine contradiction rather than two different questions.
+ *
+ * Returns false for an unknown type name or an unknown player, which are indistinguishable from
+ * "not allowed" on purpose: a caller that cannot spell the type has no business getting a yes.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Proximity_Ok(uint64 player_id,
+                                                                 const char* type_name,
+                                                                 int cell_x,
+                                                                 int cell_y)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE || type_name == NULL) {
+        return false;
+    }
+
+    StructType st = BuildingTypeClass::From_Name(type_name);
+    if (st == STRUCT_NONE) {
+        return false;
+    }
+
+    BuildingTypeClass const& btype = BuildingTypeClass::As_Reference(st);
+    CELL cell = XY_Cell(cell_x, cell_y);
+
+    return Map.Passes_Proximity_Check(&btype, house, btype.Occupy_List(true), cell);
+}
+
+/**************************************************************************************************
+ * OpenCNC3D_Force_Verdict -- Ends the mission now, won or lost, for one player (project OpenCNC3D).
+ *
+ * WHY IT IS Flag_To_Win / Flag_To_Lose AND NOT A SHORTCUT. Those two are the engine's own
+ * ending, the same pair every winning trigger and every "you have no buildings left" path
+ * reaches (house.cpp). They do not end the mission on the spot; they raise IsToWin / IsToDie,
+ * and HouseClass::AI acts on the flag a moment later, which is what runs the whole ending in
+ * its proper order -- the score tally, the win or lose movie, the campaign's next step. A
+ * cheat that fabricated a game-over event instead would skip all of that and would be testing
+ * a path the game never takes.
+ *
+ * That also means this is not instant to the frame. The verdict lands within a tick or so of
+ * the button, not inside it, and that delay is the engine working rather than the cheat
+ * failing.
+ *
+ * Returns false when player_id names nobody in this match, or when the house is already
+ * flagged, in which case nothing changed.
+ **************************************************************************************************/
+extern "C" __declspec(dllexport) bool __cdecl OpenCNC3D_Force_Verdict(uint64 player_id, bool win)
+{
+    HousesType house = OpenCNC3D_House_Of_Player(player_id);
+    if (house == HOUSE_NONE) {
+        return false;
+    }
+
+    HouseClass* hptr = HouseClass::As_Pointer(house);
+    if (hptr == NULL) {
+        return false;
+    }
+
+    return win ? hptr->Flag_To_Win() : hptr->Flag_To_Lose();
+}
