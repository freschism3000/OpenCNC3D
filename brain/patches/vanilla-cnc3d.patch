diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
index eada872..9e64583 100644
--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -112,9 +112,18 @@ set(COMMONR_SRC
     soundio_null.cpp
     video_null.cpp
     wwkeyboard.cpp
-    wwkeyboard_win32.cpp
     wwmouse.cpp
 )
+# CNC3D: the remaster lib is already headless (soundio_null/video_null); the only
+# platform dependency left was wwkeyboard_win32.cpp, which cannot compile off Windows.
+# The remaster DLL takes all input through CNC_Handle_Input(), so a null keyboard is
+# correct AND keeps the brain free of SDL -- important because these same sources must
+# cross-compile to 32-bit Windows for the Win98 target later.
+if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Windows")
+    list(APPEND COMMONR_SRC wwkeyboard_win32.cpp)
+else()
+    list(APPEND COMMONR_SRC wwkeyboard_null.cpp)
+endif()
 
 set(COMMONV_SRC
     framelimit.cpp
diff --git a/common/load.cpp b/common/load.cpp
index b3bbb7a..514eaea 100644
--- a/common/load.cpp
+++ b/common/load.cpp
@@ -166,6 +166,26 @@ void* Load_Alloc_Data(const FileClass& file)
     void* ptr = 0;
     int size = const_cast<FileClass&>(file).Size();
 
+    /* CNC3D: a file that is neither on disk nor inside a registered mixfile reports a size
+    ** of ZERO rather than failing. CCFileClass::Size() (ccfile.cpp) returns a length that
+    ** MixFileClass::Offset never writes when it does not find the entry, and its only
+    ** diagnostic is an assert(1) that cannot fire. malloc(0) then hands back a valid
+    ** non-null pointer to no usable bytes, and every caller here treats non-null as a
+    ** successful load.
+    **
+    ** Set_Font (common/font.cpp) is the one that dies of it: its only guard is
+    ** "if (fontptr)", so it accepts the empty block, reads a 16-bit block offset out of it,
+    ** and dereferences fontptr + that offset, up to 64KB past a zero-byte allocation. Whether
+    ** that address is on a committed page varies per launch, which is an intermittent
+    ** SIGSEGV on the title screen's version print and nowhere else.
+    **
+    ** NULL is the failure value every caller on this path already handles, because it is
+    ** what the MFCD::Retrieve fonts return when they are absent.
+    */
+    if (size <= 0) {
+        return (0);
+    }
+
     ptr = malloc(size);
     if (ptr) {
         const_cast<FileClass&>(file).Read(ptr, size);
diff --git a/tiberiandawn/CMakeLists.txt b/tiberiandawn/CMakeLists.txt
index a26cf46..82833f7 100644
--- a/tiberiandawn/CMakeLists.txt
+++ b/tiberiandawn/CMakeLists.txt
@@ -158,6 +158,37 @@ endif()
 
 include(ProductVersion)
 
+# CNC3D: dllinterface.{h,cpp} (the CNC_* API) is written for MSVC and uses __int64,
+# __declspec and types declared inside anonymous unions. Clang/GCC accept all of that
+# with the Microsoft-extension flags, so the API compiles unmodified off Windows.
+# Keeping the source untouched matters: it must still build for 32-bit Windows later.
+if(BUILD_REMASTERTD AND NOT MSVC)
+    set(CNC3D_MS_FLAGS -fms-extensions)
+    include(CheckCXXCompilerFlag)
+    check_cxx_compiler_flag(-fdeclspec CNC3D_HAS_FDECLSPEC)
+    if(CNC3D_HAS_FDECLSPEC)
+        list(APPEND CNC3D_MS_FLAGS -fdeclspec)
+    endif()
+endif()
+
+# CNC3D: EIGHTPLAYERS widens the multiplayer roster from six to eight houses
+# (Multi7/Multi8, grey and brown -- the two colors Red Alert added). Configure with
+# -DEIGHTPLAYERS=OFF to rebuild the stock six-player engine.
+option(EIGHTPLAYERS "Eight multiplayer houses instead of the stock six" ON)
+if(EIGHTPLAYERS)
+    set(CNC3D_EIGHTPLAYERS_DEF EIGHTPLAYERS)
+else()
+    set(CNC3D_EIGHTPLAYERS_DEF "")
+endif()
+
+# CNC3D: the map-editor interface is COM-based (SAFEARRAY/HRESULT/VT_UI1) and is
+# Windows-only. The headless brain does not need it, so it is dropped off Windows.
+if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Windows")
+    set(CNC3D_EDITOR_IFACE dllinterfaceeditor.cpp)
+else()
+    set(CNC3D_EDITOR_IFACE "")
+endif()
+
 if(BUILD_REMASTERTD)
     if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Windows")
         # Generate windows version info.
@@ -175,13 +206,17 @@ if(BUILD_REMASTERTD)
     endif()
     add_library(TiberianDawn SHARED 
         dllinterface.cpp
-        dllinterfaceeditor.cpp
+        ${CNC3D_EDITOR_IFACE}
         sidebarglyphx.cpp
         ${TIBDAWN_SRC}
         ${TIBDAWN_HEADERS}
         ${REMASTERTD_RC}
     )
-    target_compile_definitions(TiberianDawn PUBLIC $<$<CONFIG:Debug>:_DEBUG> ${REMASTER_DEFS} MEGAMAPS)
+    target_compile_definitions(TiberianDawn PUBLIC $<$<CONFIG:Debug>:_DEBUG> ${REMASTER_DEFS} MEGAMAPS ${CNC3D_EIGHTPLAYERS_DEF})
+    if(CNC3D_MS_FLAGS)
+        target_compile_options(TiberianDawn PRIVATE ${CNC3D_MS_FLAGS})
+        target_compile_options(commonr PRIVATE ${CNC3D_MS_FLAGS})
+    endif()
     target_include_directories(TiberianDawn PUBLIC ${CMAKE_SOURCE_DIR} .)
     target_link_libraries(TiberianDawn commonr ${REMASTER_LIBS} ${STATIC_LIBS})
     set_target_properties(TiberianDawn PROPERTIES PREFIX "")
@@ -230,7 +265,7 @@ if(BUILD_VANILLATD)
         )
     endif()
 
-    target_compile_definitions(VanillaTD PUBLIC $<$<CONFIG:Debug>:_DEBUG> ${VANILLA_DEFS} MEGAMAPS)
+    target_compile_definitions(VanillaTD PUBLIC $<$<CONFIG:Debug>:_DEBUG> ${VANILLA_DEFS} MEGAMAPS ${CNC3D_EIGHTPLAYERS_DEF})
     target_include_directories(VanillaTD PUBLIC ${CMAKE_SOURCE_DIR} .)
     target_link_libraries(VanillaTD commonv ${VANILLA_LIBS} ${STATIC_LIBS})
     set_target_properties(VanillaTD PROPERTIES OUTPUT_NAME vanillatd)
