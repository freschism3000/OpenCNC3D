+    if (obj->What_Am_I() == RTTI_UNIT) {
+        tface = (int)(unsigned char)((UnitClass*)obj)->SecondaryFacing.Current();
+    } else if (obj->What_Am_I() == RTTI_AIRCRAFT) {
