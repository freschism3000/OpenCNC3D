+    /* THE CELL NUMBER THIS MAP'S OWN INI WOULD USE, which depends on the map, not on
+       the build. A Version=1 (MEGA) scenario numbers cells y*MAP_CELL_W+x; a legacy
+       scenario numbers them y*64+x and the engine confines it into the top-left of the
+       wider space, so reporting the engine's stride for one of those hands back a
+       number the INI never contained.
+
+       Both halves have been wrong here in turn: the original hardcoded 64 (right for
+       legacy, wrong for MEGA) and then a hardcoded MAP_CELL_W (right for MEGA, wrong
+       for legacy). It is a per-scenario question and it is now asked per scenario.
+       No consumer reads this field today -- the host parses the honest x=/y= fields --
+       so this is correctness, not a fix for anything visible. */
+    int oldcell = (Map.MapBinaryVersion == MAP_VERSION_MEGA)
+                      ? cy * MAP_CELL_W + cx
+                      : cy * 64 + cx;
+#else
+    int oldcell = cell;
+#endif
+
+    CELL ccell = Coord_Cell(obj->Center_Coord());
+
+    const char* mission = "-";
+    if (obj->Is_Techno()) {
+        mission = MissionClass::Mission_Name(((TechnoClass*)obj)->Get_Mission());
+    }
+
+    /*
+    **	CNC3D geometry block. The renderer needs three things the old dump did not carry:
+    **
+    **	  lx/ly     the exact lepton position (256 leptons per cell), so moving units are not
+    **	            snapped to cell centres and so sub-cell placement is honest.
+    **	  fw/fh     the footprint in cells. For buildings this comes straight out of
+    **	            BuildingTypeClass::Width()/Height(), i.e. the BSIZE_* declared in bdata.cpp.
+    **	            Everything else occupies its own cell, so 1x1.
+    **	  face      PrimaryFacing (0..255, 0 = north, increasing clockwise) and, where the type
+    **	            has a turret, the secondary/turret facing. Structures carry the facing the
